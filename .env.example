# Copy to .env (git-ignored) and fill in one key. Never commit .env.
LLM_PROVIDER=gemini          # gemini (free tier) | groq (free tier) | claude (paid)
GEMINI_API_KEY=              # aistudio.google.com -> Get API key
GROQ_API_KEY=                # console.groq.com -> API Keys (also the backup when Gemini is busy)
ANTHROPIC_API_KEY=           # console.anthropic.com -> API Keys
# LLM_MODEL=                 # optional: override the provider's default model

# Voice and WhatsApp (only for: python -m gstagent.channels.live)
SARVAM_API_KEY=              # dashboard.sarvam.ai -> API keys (₹100 free credit)
TELEGRAM_BOT_TOKEN=          # Telegram -> @BotFather -> /newbot (the live demo channel)
TELEGRAM_DEMO_CHAT=          # send /start to your bot, then: uv run python -m gstagent.channels.telegram
WHATSAPP_TOKEN=              # developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_ID=           # same page: the test number's "Phone number ID"
WHATSAPP_DEMO_TO=            # your own phone, with country code, no + (add it as a test recipient)
WHATSAPP_VERIFY_TOKEN=       # any word you choose; type the same one in the webhook setup
WHATSAPP_APP_SECRET=         # app settings -> Basic -> App secret
